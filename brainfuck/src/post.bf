# request header: major minor opcode flags length request id
, @MAJ                                    # read MAJ
>>>> , @J                                 # minor is not checked
[-] @J                                    # clear J
<<< , @OP                                 # read OP
>>> , @J                                  # flags ignored; payload layout is fixed per opcode
[-] @J                                    # clear J
, @J                                      # length low ignored; payload layout is fixed per opcode
[-] @J                                    # clear J
, @J                                      # length high ignored; payload layout is fixed per opcode
[-] @J                                    # clear J
<< , @ID0                                 # request id low
> , @ID1                                  # request id high

# ABI major version
<<< [- >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>> ~33+ >+ <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<< ~34] @MAJ  # copy MAJ
>>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>> ~34 [- <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<< ~34+ >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>> ~34] @t1  # move t1 into MAJ
< - @t0                                   # subtract 1
>> + @t2                                  # assume equal
<< [ @t0                                  # if different
    >> [-] @t2                            # not equal
    # response header
    > + @t3                               # major
    . @t3                                 # write t3
    [-] @t3                               # clear t3
    . @t3                                 # write t3
    [-] @t3                               # clear t3
    <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<< ~35 [- >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>> ~35+ >+ <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<<< ~36] @OP  # copy OP to t3
    >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>> ~36 [- <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<<< ~36+ >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>> ~36] @t4  # move t4 into OP
    < ++++++++++ ++++++++++ ++++++++++ ++++++++++ ++++++++++ ++++++++++ ++++++++++ ++++++++++ ++++++++++ ++++++++++ ++++++++++ ++++++++++ ++++++++ ~128 @t3  # opcode with the response bit
    . @t3                                 # write t3
    [-] @t3                               # clear t3
    + @t3                                 # status
    . @t3                                 # write t3
    [-] @t3                               # clear t3
    . @t3                                 # write t3
    [-] @t3                               # clear t3
    . @t3                                 # write t3
    [-] @t3                               # clear t3
    <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<< ~34 . @ID0  # echo request id
    > . @ID1                              # write ID1
    >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> ~30 [-] @t0  # clear t0
] @t0
>> [ @t2                                  # if equal
    <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< ~30 [-] @UNH  # clear UNH
    + @UNH                                # UNH plus 1
    # opcode 16
    <<<< [- >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>> ~35+ >+ <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<<< ~36] @OP  # copy OP
    >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>> ~36 [- <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<<< ~36+ >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>> ~36] @t4  # move t4 into OP
    < ---------- ------ ~16 @t3           # subtract 16
    >> + @t5                              # assume equal
    << [ @t3                              # if different
        >> [-] @t5                        # not equal
        << [-] @t3                        # clear t3
    ] @t3
    >> [ @t5                              # if equal
        <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<< ~33 [-] @UNH  # clear UNH
        # OP CLASSIFY POST
        >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>> ~56 , @VAL  # model is the validated render model
        [ @VAL                            # normalize VAL
            <<<<<<<<<< <<<<<<<<<< << ~22 + @t6  # t6 plus 1
            >>>>>>>>>> >>>>>>>>>> >> ~22 [-] @VAL  # clear VAL
        ] @VAL
        <<<<<<<<<< <<<<<<<<<< << ~22 [- >>>>>>>>>> >>>>>>>>>> >> ~22+ <<<<<<<<<< <<<<<<<<<< << ~22] @t6  # move t6 into VAL
        >>>>>>>>>> >>>>>>>>>> >>> ~23 , @ALW  # action fallback allowed
        [ @ALW                            # normalize ALW
            <<<<<<<<<< <<<<<<<<<< <<< ~23 + @t6  # t6 plus 1
            >>>>>>>>>> >>>>>>>>>> >>> ~23 [-] @ALW  # clear ALW
        ] @ALW
        <<<<<<<<<< <<<<<<<<<< <<< ~23 [- >>>>>>>>>> >>>>>>>>>> >>> ~23+ <<<<<<<<<< <<<<<<<<<< <<< ~23] @t6  # move t6 into ALW
        >>>>>>>>>> >>>>>>>>>> >>>> ~24 , @META  # promoted metadata object present
        [ @META                           # normalize META
            <<<<<<<<<< <<<<<<<<<< <<<< ~24 + @t6  # t6 plus 1
            >>>>>>>>>> >>>>>>>>>> >>>> ~24 [-] @META  # clear META
        ] @META
        <<<<<<<<<< <<<<<<<<<< <<<< ~24 [- >>>>>>>>>> >>>>>>>>>> >>>> ~24+ <<<<<<<<<< <<<<<<<<<< <<<< ~24] @t6  # move t6 into META
        >>>>>>>>>> >>>>>>>>>> >>>>> ~25 , @NF  # number of text fields
        >> [-] @ENTIDX                    # ENTIDX is 255
        - @ENTIDX                         # ENTIDX minus 1
        << [ @NF                          # each text field
            - @NF                         # NF minus 1
            # text field: length u16 then chunks of codes ending with an empty chunk
            <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<< ~54 , @L0  # length low
            > , @L1                       # length high
            # more than 256 characters can never be an entry identifier
            # length high is zero
            [- >>>>>>>>>> >>>>>>>>>> >>>>>>>> ~28+ >+ <<<<<<<<<< <<<<<<<<<< <<<<<<<<< ~29] @L1  # copy L1
            >>>>>>>>>> >>>>>>>>>> >>>>>>>>> ~29 [- <<<<<<<<<< <<<<<<<<<< <<<<<<<<< ~29+ >>>>>>>>>> >>>>>>>>>> >>>>>>>>> ~29] @t7  # move t7 into L1
            > + @t8                       # assume equal
            << [ @t6                      # if different
                >> [-] @t8                # not equal
                # length high is one
                <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< ~30 [- >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> > ~31+ >+ <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< << ~32] @L1  # copy L1
                >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >> ~32 [- <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< << ~32+ >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >> ~32] @t10  # move t10 into L1
                < - @t9                   # subtract 1
                >> + @t11                 # assume equal
                << [ @t9                  # if different
                    >> [-] @t11           # not equal
                    <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< << ~32 [-] @DEAD  # clear DEAD
                    + @DEAD               # DEAD plus 1
                    >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> ~30 [-] @t9  # clear t9
                ] @t9
                >> [ @t11                 # if equal
                    <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<< ~34 [- >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>> ~35+ >+ <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<<< ~36] @L0  # copy L0 to t12
                    >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>> ~36 [- <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<<< ~36+ >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>> ~36] @t13  # move t13 into L0
                    < [ @t12              # if t12 then
                        <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<< ~33 [-] @DEAD  # clear DEAD
                        + @DEAD           # DEAD plus 1
                        >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>> ~33 [-] @t12  # clear t12
                    ] @t12
                    < [-] @t11            # clear t11
                ] @t11
                <<<<< [-] @t6             # clear t6
            ] @t6
            >> [ @t8                      # if equal
                [-] @t8                   # clear t8
            ] @t8
            <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< < ~31 [-] @L0  # clear L0
            > [-] @L1                     # clear L1
            >>>>>> [-] @B0                # clear B0
            + @B0                         # B0 plus 1
            <<<<<<<< ~8 , @K              # first chunk length
            [ @K                          # each chunk
                [ @K                      # each character of the chunk
                    - @K                  # K minus 1
                    < , @CH               # read CH
                    >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> > ~31 + @t6  # t6 plus 1
                    <<<<<<<<<< <<<<<<<<<< <<<<<<< ~27 [- >>>>>>>>>> >>>>>>>>>> >>>>>>>> ~28+ >+ <<<<<<<<<< <<<<<<<<<< <<<<<<<<< ~29] @DEAD  # copy DEAD to t7
                    >>>>>>>>>> >>>>>>>>>> >>>>>>>>> ~29 [- <<<<<<<<<< <<<<<<<<<< <<<<<<<<< ~29+ >>>>>>>>>> >>>>>>>>>> >>>>>>>>> ~29] @t8  # move t8 into DEAD
                    < [ @t7               # if t7 then
                        < [-] @t6         # clear t6
                        > [-] @t7         # clear t7
                    ] @t7
                    < [ @t6               # the text can still be an identifier
                        # segment scanner on one character
                        # case CH equals 0
                        <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< < ~31 [- >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >> ~32+ >+ <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<< ~33] @CH  # copy CH
                        >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>> ~33 [- <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<< ~33+ >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>> ~33] @t8  # move t8 into CH
                        > + @t9           # assume equal
                        << [ @t7          # if different
                            >> [-] @t9    # not equal
                            << [-] @t7    # clear t7
                        ] @t7
                        >> [ @t9          # if equal
                            <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< ~30 [-] @DEAD  # clear DEAD
                            + @DEAD       # DEAD plus 1
                            >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> ~30 [-] @t9  # clear t9
                        ] @t9
                        # case CH equals 1
                        <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<< ~34 [- >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >> ~32+ >+ <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<< ~33] @CH  # copy CH
                        >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>> ~33 [- <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<< ~33+ >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>> ~33] @t8  # move t8 into CH
                        < - @t7           # subtract 1
                        >> + @t9          # assume equal
                        << [ @t7          # if different
                            >> [-] @t9    # not equal
                            << [-] @t7    # clear t7
                        ] @t7
                        >> [ @t9          # if equal
                            # segment ends: classify it as a token
                            <<<<<<<<<< <<<<<<<<<< <<<<<< ~26 [-] @TOK  # default token plain letters
                            + @TOK        # TOK plus 1
                            # scanner state 0
                            <<<<<<<<<< ~10 [- >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>>> ~37+ >+ <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<<<<< ~38] @S  # copy S
                            >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>>>> ~38 [- <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<<<<< ~38+ >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>>>> ~38] @t11  # move t11 into S
                            > + @t12      # assume equal
                            << [ @t10     # if different
                                >> [-] @t12  # not equal
                                << [-] @t10  # clear t10
                            ] @t10
                            >> [ @t12     # if equal
                                <<<<<<<<<< <<<<<<<<<< <<<<<<<<< ~29 [-] @TOK  # TOK becomes 0
                                >>>>>>>>>> >>>>>>>>>> >>>>>>>>> ~29 [-] @t12  # clear t12
                            ] @t12
                            # scanner state 8
                            <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<<<<<< ~39 [- >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>>> ~37+ >+ <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<<<<< ~38] @S  # copy S
                            >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>>>> ~38 [- <<<<<<<<<< <<<<<<<<<< <<<<<<<<<< <<<<<<<< ~38+ >>>>>>>>>> >>>>>>>>>> >>>>>>>>>> >>>>>>>> ~38] @t11  # move t11 into S
                            < -------- ~8 @t10  # subtract 8
                            >> + @t12     # assume equal
                            << [ @t10     # if different
