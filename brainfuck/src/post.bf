# %cell t21 54   scratch; zero whenever free
# %cell t22 55   scratch; zero whenever free
# %cell t23 56   scratch; zero whenever free
# %cell t24 57   scratch; zero whenever free
# %cell t25 58   scratch; zero whenever free
# %cell t26 59   scratch; zero whenever free
# %cell t27 60   scratch; zero whenever free
# %cell VAL 61
# %cell ALW 62
# %cell META 63
# %cell NF 64
# %cell IDX 65
# %cell ENTIDX 66
# %cell ENTKIND 67
